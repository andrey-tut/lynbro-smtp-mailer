msgstr "Mottagare, ämne eller fel"

msgid "Search the log"
msgstr "Sök i loggen"

msgid "Filter"
msgstr "Filtrera"

msgid "Clear"
msgstr "Rensa"

msgid "No emails match this filter."
msgstr "Inga e-postmeddelanden matchar detta filter."

msgid ""
"No emails logged yet. Send a test from the Test & diagnostics tab to see the"
" first entry here."
msgstr ""
"Inga e-postmeddelanden har loggats ännu. Skicka ett test från fliken Test "
"och diagnostik för att se den första posten här."

msgid "Select all"
msgstr "Välj alla"

msgid "Date"
msgstr "Datum"

msgid "To"
msgstr "Till"

msgid "Subject"
msgstr "Ämne"

msgid "Sent through"
msgstr "Skickat via"

msgid "Actions"
msgstr "Åtgärder"

