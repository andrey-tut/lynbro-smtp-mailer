msgstr "Testläge (omdirigerat)"

msgid "The log is switched off in Settings — no new emails are recorded."
msgstr ""
"Loggen är avstängd i Inställningar — inga nya e-postmeddelanden registreras."

msgid "Sent, 30 days"
msgstr "Skickat, 30 dagar"

msgid "Failed, 30 days"
msgstr "Misslyckades, 30 dagar"

msgid "Held back, 30 days"
msgstr "Hålls tillbaka, 30 dagar"

msgid "Status"
msgstr "Status"

