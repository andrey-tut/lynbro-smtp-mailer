msgstr ""
"Qed tippubblika linja tal-log? Neħħi l-indirizzi l-ewwel — it-tab Test diġà "
"jaħbi l-password."

msgid "You do not have permission to do that."
msgstr "M’għandekx permess tagħmel dan."

msgid "Enter a valid recipient address."
msgstr "Daħħal indirizz riċevitur validu."

msgid ""
"%1$s: the main SMTP connection failed and the backup delivered the email. "
"Error: %2$s"
msgstr ""
"%1$s: il-konnessjoni SMTP ewlenija fallew u l-backup bagħat l-email. Żball: "
"%2$s"

msgid "%1$s: an email could not be sent. Error: %2$s"
msgstr "%1$s: email ma setgħetx tintbagħat. Żball: %2$s"

