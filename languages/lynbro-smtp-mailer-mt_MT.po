msgid "No emails match this filter."
msgstr "L-ebda email ma taqbel ma’ dan il-filtru."

msgid ""
"No emails logged yet. Send a test from the Test & diagnostics tab to see the"
" first entry here."
msgstr ""
"Għadu ma hemm l-ebda email irreġistrata. Ibgħat test mit-tab Test & "
"diagnostics biex tara l-ewwel entrata hawnhekk."

