msgstr "Sulaikyta, 30 dienų"

msgid "Status"
msgstr "Būsena"

msgid "All statuses"
msgstr "Visos būsenos"

msgid "Recipient, subject or error"
msgstr "Gavėjas, tema arba klaida"

