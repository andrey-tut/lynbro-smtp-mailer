msgstr "Ieškoti žurnale"

msgid "Filter"
msgstr "Filtruoti"

msgid "Clear"
msgstr "Išvalyti"

msgid "No emails match this filter."
msgstr "Nė vienas el. laiškas neatitinka šio filtro."

msgid ""
"No emails logged yet. Send a test from the Test & diagnostics tab to see the"
" first entry here."
msgstr ""
"Dar neužregistruota el. laiškų. Nusiųskite bandomąjį laišką iš skilties "
"Testavimas ir diagnostika, kad čia matytumėte pirmą įrašą."

msgid "Select all"
msgstr "Pažymėti visus"

msgid "Date"
msgstr "Data"

msgid "To"
msgstr "Kam"

