msgstr "PHP mail()"

msgid "Test mode (redirected)"
msgstr "Mód tástála (athdhírithe)"

msgid "The log is switched off in Settings — no new emails are recorded."
msgstr ""
"Tá an logáil múchta sna Socruithe — ní thaifeadtar aon ríomhphoist nua."

msgid "Sent, 30 days"
msgstr "Seolta, 30 lá"

msgid "Failed, 30 days"
msgstr "Theip, 30 lá"

msgid "Held back, 30 days"
msgstr "Coinnithe siar, 30 lá"

msgid "Status"
msgstr "Stádas"

msgid "All statuses"
msgstr "Gach stádas"

msgid "Recipient, subject or error"
msgstr "Faighteoir, ábhar nó earráid"

msgid "Search the log"
msgstr "Cuardaigh an log"

msgid "Filter"
msgstr "Scagaire"

msgid "Clear"
msgstr "Glan"

msgid "No emails match this filter."
msgstr "Ní oireann aon ríomhphoist don scagaire seo."

msgid ""
"No emails logged yet. Send a test from the Test & diagnostics tab to see the"
" first entry here."
msgstr ""
"Níl aon ríomhphoist logáilte fós. Seol tástáil ón gcluaisín Tástáil & "
"diagnóisic chun an chéad iontráil a fheiceáil anseo."

msgid "Select all"
msgstr "Roghnaigh uile"

msgid "Date"
msgstr "Dáta"

msgid "To"
msgstr "Chuig"

msgid "Subject"
msgstr "Ábhar"

msgid "Sent through"
msgstr "Seolta trí"

msgid "Actions"
msgstr "Gníomhartha"

msgid "Select"
msgstr "Roghnaigh"

