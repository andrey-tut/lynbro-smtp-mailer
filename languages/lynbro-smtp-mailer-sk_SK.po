"Záznam je v Nastaveniach vypnutý — žiadne nové e-maily sa nezaznamenávajú."

msgid "Sent, 30 days"
msgstr "Odoslané, 30 dní"

msgid "Failed, 30 days"
msgstr "Neúspešné, 30 dní"

msgid "Held back, 30 days"
msgstr "Pozastavené, 30 dní"

msgid "Status"
