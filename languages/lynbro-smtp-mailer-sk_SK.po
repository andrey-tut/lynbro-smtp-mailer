msgstr "Všetky stavy"

msgid "Recipient, subject or error"
msgstr "Príjemca, predmet alebo chyba"

msgid "Search the log"
msgstr "Prehľadať záznam"

msgid "Filter"
msgstr "Filter"

msgid "Clear"
msgstr "Vymazať"

msgid "No emails match this filter."
msgstr "Tomuto filtru nevyhovujú žiadne e-maily."

msgid ""
"No emails logged yet. Send a test from the Test & diagnostics tab to see the"
" first entry here."
msgstr ""
"Zatiaľ nie sú zaznamenané žiadne e-maily. Odoslaním testu na karte "
"Testovanie a diagnostika sa sem zobrazí prvý záznam."

msgid "Select all"
msgstr "Vybrať všetko"

msgid "Date"
msgstr "Dátum"

msgid "To"
msgstr "Komu"

msgid "Subject"
msgstr "Predmet"

msgid "Sent through"
msgstr "Odoslané cez"

msgid "Actions"
msgstr "Akcie"

