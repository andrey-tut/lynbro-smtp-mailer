msgid "The log is switched off in Settings — no new emails are recorded."
msgstr "Журнал отключен в настройках — новые письма не записываются."

msgid "Sent, 30 days"
msgstr "Отправлено, 30 дней"

msgid "Failed, 30 days"
msgstr "Не удалось отправить, 30 дней"

msgid "Held back, 30 days"
msgstr "Задержано, 30 дней"

