msgid "Filter"
msgstr "Фильтр"

msgid "Clear"
msgstr "Очистить"

msgid "No emails match this filter."
msgstr "Нет писем, подходящих под этот фильтр."

msgid ""
"No emails logged yet. Send a test from the Test & diagnostics tab to see the"
" first entry here."
msgstr ""
"Пока не зарегистрировано ни одного письма. Отправьте тест из вкладки «Тест и"
" диагностика», чтобы увидеть здесь первую запись."

msgid "Select all"
msgstr "Выбрать все"

msgid "Date"
msgstr "Дата"

msgid "To"
msgstr "Кому"

msgid "Subject"
msgstr "Тема"

msgid "Sent through"
msgstr "Отправлено через"

msgid "Actions"
msgstr "Действия"

