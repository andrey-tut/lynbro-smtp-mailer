msgstr "Retrimite"

msgid "Delete the selected entries?"
msgstr "Ștergeți intrările selectate?"

msgid "Delete selected"
msgstr "Șterge selectate"

msgid "%1$s entries · deleted automatically after %2$s days"
msgstr "%1$s intrări · șterse automat după %2$s zile"

msgid "Checking…"
msgstr "Se verifică…"

msgid "Sent. Check the inbox (and the spam folder) of the recipient."
msgstr "Trimis. Verificați inboxul (și folderul de spam) al destinatarului."

msgid "Not sent."
msgstr "Netrimis."

msgid "open"
msgstr "deschis"

msgid "blocked"
msgstr "blocat"

