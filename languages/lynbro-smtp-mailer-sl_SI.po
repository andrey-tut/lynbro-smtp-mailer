msgstr "Počisti"

msgid "No emails match this filter."
msgstr "Nobeno e-poštno sporočilo ne ustreza temu filtru."

msgid ""
"No emails logged yet. Send a test from the Test & diagnostics tab to see the"
" first entry here."
msgstr ""
"Zaenkrat ni zabeleženih e-poštnih sporočil. Pošljite test na zavihku "
"Testiranje in diagnostika, da se tu prikaže prvi zapis."

msgid "Select all"
msgstr "Izberi vse"

