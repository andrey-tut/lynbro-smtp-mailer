msgstr "Pretraži zapisnik"

msgid "Filter"
msgstr "Filtriraj"

msgid "Clear"
msgstr "Očisti"

msgid "No emails match this filter."
msgstr "Nijedna e-pošta ne odgovara ovom filtru."

msgid ""
"No emails logged yet. Send a test from the Test & diagnostics tab to see the"
" first entry here."
msgstr ""
"Još nema zabilježene e-pošte. Pošaljite test na kartici Testiranje i "
"dijagnostika da biste ovdje vidjeli prvi unos."

msgid "Select all"
msgstr "Odaberi sve"

msgid "Date"
msgstr "Datum"

msgid "To"
msgstr "Prima"

msgid "Subject"
msgstr "Predmet"

msgid "Sent through"
msgstr "Poslano putem"

msgid "Actions"
msgstr "Radnje"

msgid "Select"
msgstr "Odaberi"

